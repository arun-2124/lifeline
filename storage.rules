rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Donation original photos — donor-only write, authenticated read
    match /donations/{donationId}/{itemId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Thumbnails generated by Cloud Function — server-only write
    match /donations/{donationId}/{itemId}/thumbnails/{size}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // User avatars — self-only write, authenticated read
    match /users/{userId}/avatar/{fileName} {
      allow read: if isAuthenticated();
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
