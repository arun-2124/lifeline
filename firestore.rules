rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'ADMIN';
    }

    function hasRole(targetRole) {
      return isAuthenticated() && request.auth.token.role == targetRole;
    }

    // ── Users Collection ──
    // Anyone can create their own profile with a role.
    // Users cannot modify their own role, verificationStatus, or accountStatus.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
                    && !('customClaims' in request.resource.data)
                    && !('isAdmin' in request.resource.data);

      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['role', 'verificationStatus', 'customClaims', 'createdAt', 'accountStatus']);

      allow delete: if false;
    }

    // ── Donations Collection ──
    match /donations/{donationId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.donorId == request.auth.uid;

      allow update: if isAuthenticated()
                    && (
                      resource.data.donorId == request.auth.uid ||
                      isAdmin()
                    );

      allow delete: if false;

      // Status Audit Log (Server-only writes via Admin SDK)
      match /statusLog/{logId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // ── NGO Requests Collection ──
    match /ngo_requests/{requestId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.ngoId == request.auth.uid;

      allow update: if isAuthenticated()
                    && (
                      resource.data.ngoId == request.auth.uid ||
                      resource.data.donorId == request.auth.uid ||
                      isAdmin()
                    );

      allow delete: if false;
    }

    // ── Accepted Donations Collection ──
    match /accepted_donations/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // ── Delivery Requests Collection ──
    match /delivery_requests/{deliveryId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated();

      allow update: if isAuthenticated();

      allow delete: if false;
    }

    // ── Notifications Collection ──
    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
                  && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated();

      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);

      allow delete: if false;
    }

    // ── QR Codes Collection ──
    match /qr_codes/{qrId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // ── Delivery Logs Collection (Append-only audit trail) ──
    match /delivery_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // ── Tracking Collection (Real-time GPS telemetry) ──
    match /tracking/{trackingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ── Location Updates Collection (GPS breadcrumbs) ──
    match /location_updates/{updateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // ── Volunteer Assignments Collection ──
    match /volunteer_assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // ── Delivery History Collection ──
    match /delivery_history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // ── Geohash Spatial Indexes ──
    match /geohash_indexes/{hash}/donations/{donationId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── Admin Collection ──
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // ── Audit Logs (Server-only write, admin read) ──
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Rate Limits (Server-only) ──
    match /rate_limits/{limitId} {
      allow read, write: if false;
    }

    // ── Idempotency Keys (Server-only) ──
    match /idempotency_keys/{keyId} {
      allow read, write: if false;
    }
  }
}
